lhdreamcity.com, www.lhdreamcity.com {
    reverse_proxy dreamcity-web:3000
}

work.lhdreamcity.com {
    handle /api/library/* {
        reverse_proxy library:3001
    }
    handle /api/upload* {
        reverse_proxy library:3001
    }
    handle /api/* {
        reverse_proxy workbench-deploy-app-1:3000
    }
    handle /auth/* {
        reverse_proxy workbench-deploy-app-1:3000
    }
    handle {
        root * /srv
        encode gzip
        header Cache-Control "no-cache"
        file_server
    }
}
